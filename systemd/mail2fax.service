[Unit]
Description=mail2fax - E-Mail-zu-Fax-Gateway
Documentation=https://github.com/Internerd/mail2fax
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mail2fax
Group=mail2fax
WorkingDirectory=/opt/mail2fax
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/mail2fax/venv/bin/mail2fax web
Restart=on-failure
RestartSec=10s

# --- Absicherung des Dienstes ---------------------------------------------
# Der Dienst verarbeitet fremde E-Mails und Dokumente. Er laeuft daher ohne
# Sonderrechte und darf nur auf seine eigenen Verzeichnisse schreiben.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
# Das Asterisk-Verzeichnis wird nur beim SIP-Versand gebraucht; das
# fuehrende "-" macht es optional, falls Asterisk nicht installiert ist.
ReadWritePaths=/etc/mail2fax /var/lib/mail2fax -/etc/asterisk/mail2fax
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target
